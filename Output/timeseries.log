  3. 
.   cap frame drop kink
  4.   frame create kink C b se
  5.   forvalues C=3/19 {
  6.     cap drop t2
  7.     gen byte t2 = max(0, `C'-age74)
  8.     reg lit t? if inrange(age74, `C'-5, `C'+5) & female==`f' [pw=wt], cluster(id)
  9.     frame post kink (`C') (_b[t2]) (_se[t2])
 10.     
.     if `C'==11 local splinefn `=_b[_cons] + _b[t1]*(-5)' `=11+5' `=_b[_cons]' 11 `=_b[_cons] + (_b[t1]+_b[t2])*5' `=11-5'
 11.   }
 12.   frame kink {
 13.     gen hi = b + 1.96 * se
 14.     gen lo = b - 1.96 * se
 15.     twoway rspike hi lo C, lcolor(gs8) || rspike hi lo C if C==11, lcolor(maroon) lwidth(medthick) || line b C, lcolor(gs8) lpat(solid) lwidth(vthin) legend(off) xline(11) yline(0) ///
>            xlab(1 11 28, nogrid) ylab(-.1 0, format(%3.1f) nogrid) yscale(range(-.05 .05)) xscale(reverse) xtitle("") ///
>            `=cond(`f',"fxsize(52)","fxsize(48) yscale(off)")' plotregion(margin(0 0 0 5)) name(kinklitf`f', replace) nodraw
 16.   }
 17. 
.   reg lit ibn.birthyr if age>=23 & inrange(age74,3,19) & female==`f' [pw=wt], nocons cluster(id)
 18.   frame cp: coefplot, vertical keep(*.birthyr) rename(*.birthyr="") omit at(_coef, transform(1974 - @)) xscale(reverse off range(2 24)) xline(11) yline(0) ///
>     recast(line) lcolor(gs8...) lpat(solid...) lwidth(vthin...) ciopts(lcolor(gs8)) ///
>     `=cond(`f',"fxsize(52)","fxsize(48) yscale(off)")' plotregion(margin(0 0 0 5))  ///
>     title(`sex', size(medium)) `=cond(`f', "", "yscale(off)")' xlab(1 11 28, nogrid) ylab(.4(.1)1, format(%3.1f) nogrid) ///
>     name(trendlitf`f', replace) gen replace
 19.   frame cp: `r(graph)' || scatteri  `splinefn', recast(connected) lcolor(maroon) lwidth(medium) lpat(solid) mstyle(p1) mcolor(maroon%50) msym(smdiamond) msize(small)
 20. }
