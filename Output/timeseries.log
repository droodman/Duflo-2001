. global Nspecs 4

. foreach f in 0 1 {
  2.   foreach depvar in part lhwage {
  3.     forvalues C=17/19 {
  4.       mata t = WeightedModelAverage(μs`depvar'f`f'[|(`C'-17)*$Nspecs:+(1\$Nspecs)|], σ²s`depvar'f`f'[|(`C'-17)*$Nspecs:+(1\$Nspecs)|])
  5.       mata st_matrix("b", t[1])
  6.       mata st_matrix("V", t[2])
  7.       mat colnames b = yeduc
  8.       mat colnames V = yeduc
  9.       mat rownames V = yeduc
 10.       ereturnpost b V
 11.       eststo kIV`depvar'f`f'C`C'
 12.     }
 13.     mata t = WeightedModelAverage(μs`depvar'f`f', σ²s`depvar'f`f', (1\2\1)#J($Nspecs,1,1))  // 50% weight on age 18, 25% each on 17 & 19
 14.     mata st_matrix("b", t[1])
 15.     mata st_matrix("V", t[2])
 16.     mat colnames b = yeduc
 17.     mat colnames V = yeduc
 18.     mat rownames V = yeduc
