 13.       reg `depvar' t? if inrange(age74, `C'-5, `C'+5) & female==`f' [pw=wt]
 14.       frame post kink (`C') (_b[t2]) (_se[t2])
 15.      
.       if `C'==`kinkpt' local splinefn `=_b[_cons] + _b[t1]*(-5)' `=`kinkpt'+5' `=_b[_cons]' `kinkpt' `=_b[_cons] + (_b[t1]+_b[t2])*5' `=
> `kinkpt'-5'
 16.     }
 17.     frame kink {
 18.       gen hi = b + 1.96 * se
 19.       gen lo = b - 1.96 * se
 20.       twoway rspike hi lo C, lcolor(gs8) || rspike hi lo C if C==`kinkpt', lcolor(maroon) lwidth(medthick) || line b C, lcolor(gs8) l
> pat(solid) lwidth(vthin) legend(off) ///
>         xline(`kinkpt') yline(0) xlab(minmax `kinkpt', nogrid) ylab(,nogrid) xscale(reverse) xtitle("") ///
>         `=cond(`f', "", "yscale(off)")' `=cond(`f' & inlist(`d',1,2), "ytitle(Kink, margin(zero)) fxsize(54)", "fxsize(46)")' ///
>         plotregion(margin(zero)) name(kink`depvar'f`f', replace) 
 21.     }
 22. 
.     reg `depvar' ibn.birthyr if age>=23 & inrange(age74,-3,24) & female==`f' [pw=wt], nocons
 23.     preserve
 24.     keep in 1
 25.     coefplot, vertical keep(*.birthyr) rename(*.birthyr="") omit ///
>       recast(line) lcolor(gs8...) lpat(solid...) lwidth(vthin...) ciopts(lcolor(gs8))  ///
>       title(`sex', size(medium)) `=cond(`f', "", "yscale(off)")' `=cond(`f' & inlist(`d',1,2), "fxsize(54) ytitle(Trend, margin(zero))",
>  "fxsize(46)")' ///
>       xlab(minmax `kinkpt', nogrid) ylab(, nogrid) at(_coef, transform(1974 - @)) xscale(reverse off) xline(`kinkpt') ///
>       name(trend`depvar'f`f', replace) gen replace
 26.     `r(graph)' || scatteri `splinefn', recast(connected) lcolor(maroon) lwidth(medium) lpat(solid) mstyle(p1) mcolor(maroon%50) msym(
> smdiamond) msize(small)
 27.     restore
 28.   }
 29. }
