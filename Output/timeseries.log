. ***
. *** Simulate kinks
. ***
. {
. clear
. set obs `=35 - -15 + 1'
Number of observations (_N) was 0, now 51.
. gen age74 = _n - 1 + -15
. gen n = _n
. cap drop kink5
. gen kink5 = .
(51 missing values generated)
. cap drop n
. gen n = _n
. forvalues p=1/2 {
  2.   local title   : word `p' of Primary "Upper secondary"
  3.   local grades  : word `p' of 6 3
  4.   local years   : word `p' of 10 5
  5.   local startage: word `p' of 7 16
  6.   
.   local xs
  7.   forvalues g=1/`years' {
  8.     tempname x`g'
  9.     gen `x`g'' = clip(`startage' + `grades' - age74 - `g' + 1, 0, `grades')
 10.     local xs `xs' `x`g''
 11.   }
 12.   cap drop T
 13.   egen T = rowtotal(`xs')
 14. 
.   forvalues a=-4/27 {
 15.     cap drop t1
 16.     gen t1 = `a' - age74
 17.     cap drop t2
 18.     gen t2 = max(0,t1)
 19.     cap noi reg T t? if inrange(age74,`a'-5,`a'+5)
 20. 
.     if !_rc {
 21.       sum n if age74==`a', meanonly
 22.       if r(N) replace kink5 = _b[t2] in `r(mean)'
 23.     }
 24.   }
 25.   recode kink5 (.=0)
 26.   scatter T     age74 if inrange(age74,-5,25), name(trendsim`p', replace) msym(D) xscale(range(-5 25) reverse off) xmtick(-5/25, notick grid glpat(solid) glcolor(gs13)) xlab(-5(5)25, grid glpat(solid) glcolor(gs10) glwidth(m
> edthin)) ylab(, nogrid) ///
>     xtitle("") `=cond(`p'==1, "ytitle(Trend, margin(zero))", `"yscale(off)"')' title(`title') nodraw
 27.   scatter kink5 age74 if inrange(age74,-5,25), name(kinksim`p' , replace) msym(D) xscale(range(-5 25) reverse    ) xmtick(-5/25, notick grid glpat(solid) glcolor(gs13)) xlab(-5(5)25, grid glpat(solid) glcolor(gs10) glwidth(m
> edthin)) ylab(, nogrid) ///
>     xtitle("") `=cond(`p'==1, "ytitle(Kink, margin(0 .5))", `"yscale(off)"')' nodraw
 28. }

