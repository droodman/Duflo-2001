. ***
. *** SUSENAS: schooling trends
. ***
. 
. use "SUSENAS all" if age<56, clear

. 
. gen int birthyr = year - age

. gen byte age74 = 1974 - birthyr

. gen byte yeducp = min(6, yeduc)

. gen byte yeducls = max(yeduc,9) if yeduc>=6
(9,418,050 missing values generated)

. gen byte yeducus = yeduc if yeduc>=9
(15,462,663 missing values generated)

. 
. * clustering by sampling unit within each survey increases se's 5-10% over "robust"; for sake of more complete samples, seems better not
>  to cluster
. // egen long id = group(year prop kab urban nks)
. // eststo cluster: reg yeduc ibn.birthyr if age>=23 & inrange(age74,-8,34) [pw=wt], nocons cluster(id)
. // eststo robust : 
. // esttab cluster robust, se
. 
. forvalues f=0/1 {
  2.   local sex: word `=`f'+1' of Men Women
  3.   forvalues g=1/19 {
  4.     cap drop yeduc`g'
  5.     gen byte yeduc`g' = yeduc>=`g' if yeduc<.
  6.     eststo e`g': reg yeduc`g' ibn.birthyr if age>=23 & inrange(age74,-8,29) & female==`f' [pw=wt], nocons
  7.   }
  8.   sum yeduc1 if age74==-8 & age>=23 & inrange(age74,-8,34) & female==`f' [aw=wt], meanonly
  9.   local textopt `=logit(r(mean))' -8 "at least" "1 year"
 10.   foreach g in 6 9 12 {
 11.     sum yeduc`g' if age74==-8 & age>=23 & inrange(age74,-8,34) & female==`f' [aw=wt], meanonly
 12.     local textopt `textopt' `=logit(r(mean))' -8 "`g'"
 13.   }
 14.   preserve
 15.   keep in 1  // hack to speed coefplot
 16.   coefplot e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12, rename(*.birthyr="") vertical transform(* = logit(@)) at(_coef, transform(1974 - @
> )) xscale(reverse) ///
>     recast(line) lcolor(gs8...) lpat(solid...) lwidth(vthin...) ciopts(lcolor(gs8)) ///
>     xlab(-9(5)31, nogrid labsize(medsmall)) xline(11) `=cond(`f', "fxsize(`=1.5*55')", "yscale(off) fxsize(`=1.5*45')")' fysize(100) ///
>     ylab(`=logit(.05)' "0.05" `=logit(.1)' "0.1" `=logit(.2)' "0.2" `=logit(.3)' "0.3" `=logit(.4)' "0.4" `=logit(.5)' "0.5" `=logit(.6)
> ' "0.6" `=logit(.7)' "0.7" `=logit(.8)' "0.8" `=logit(.9)' "0.9"  `=logit(.95)' "0.95" `=logit(.99)' "0.99", labsize(medsmall) nogrid) /
> //
>     legend(off) plotregion(margin(0 0 0 0)) graphregion(margin(0 12 0 2)) xtitle("") text(`textopt', place(e) just(left) size(medsmall) 
> margin(tiny)) ///
>     title(`sex') name(trendsf`f', replace)
 17.   restore
 18. }
