. 
. {
. use "DHS/DHS all" if edattain<2, clear
. gen age74 = 1974 - birthyr
. gen byte t1 = 11 - age74
. gen byte t2 = max(0,t1)
. gen byte age = year - birthyr
. egen id = group(year clustid)
. 
. forvalues f=0/1 {
  2.   eststo kinklitf`f': reg lit t? if inrange(age74, 11-5, 11+5) & female==`f' [pw=wt], cluster(id)
  3. }
