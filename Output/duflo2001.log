. ***
. *** Perform partial diagnostic checks for inconsistency of unweighted OLS, described in text
. ***
. {
. preserve
. gen T = young#c.ninnew
(17 missing values generated)
. gen p = 1 / wt
(17 missing values generated)
. foreach var in yeduc lhwage {
  2.   cap drop e _T
  3.   cap drop _`var'
  4.   partialhdfejl `var' T if (young | old) & year==1995, a(birthplnew birthyr##c.ch71new) prefix(_)  // under nul
> l that unweighted OLS is consistent...
  5.   qui reg _`var' _T, nocons
  6.   predict e if e(sample), resid
  7.   
.   reg  e p [pw=wt] if e(sample), cluster(birthplnew)                                               // speaks to ex
> ogeneity condition: is e mean-independent of p, T jointly?
  8.   reg _T p [pw=wt] if e(sample), cluster(birthplnew)                                               // speaks to
>  endogeneity condition: is p mean-independent of T?
