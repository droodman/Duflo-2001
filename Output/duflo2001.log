.           reghdfejl `depvar' 1.young#c.nin`new' [pw=`wt'] if e(sample), a(birthyr##c.(`controls') birthpl`new' year) vce(bs, cluster(birthpl`new') procs($procs) reps(1000) seed(`seed') saving("`bs'", replace)
> ) nosamp
 20.           scalar b`wt'exp = _b[1.young#c.nin`new']
 21.           frame bs: use "`bs'.dta", clear
 22.           frame bs: putmata bs`wt'exp = _bs_1, replace
 23. 
.           cap noi reg `depvar' 1.old#c.nin`new' ib1974.birthyr##c.(`controls') i.birthpl`new' i.year [iw=`wt'] if inrange(year,`years') & (`edvar' | year<1974-$reallyoldmax+$retireage) & (old | reallyold)
 24.           if _rc {
