  5.   replace reallyold = inrange(age74,$reallyoldmin,$reallyoldmax)
  6. 
.   cap erase "Public/Output/RF`yearname'.rtf"
  7.   forvalues c=1(-1)0 {  // control sets, 0=none, 1=minimal, 2=intermediate, 3=full
  8.     eststo clear
  9.     foreach depvar in primary yeduc part lhwage {
 10.       local edvar = inlist("`depvar'","primary","yeduc")
 11.       foreach new in `=cond(`y'==1 & `c' & inlist("`depvar'","yeduc","lhwage"), `""""', "")' new {
 12.         local controls: word `=`c'+1' of "" ch71`new' "ch71`new' en71`new'" "ch71`new' en71`new' wsppc"
 13. 
.         local seed `c(seed)'  // save to give weighted & unweighted, experiment and placebo, Hausman bootstraps same DGPs
 14.         foreach wt in 1 `=cond("`new'"=="","","wt")' {
 15.           reg `depvar' 1.young#c.nin`new' ib1974.birthyr##c.(`controls') i.birthpl`new' i.year [pw=`wt'] if inrange(year,`years') & (`edvar' | year<1974-$oldmax+$retireage) & (old | young)
 16.           est store exp
 17.           qui count if e(sample)
 18.           scalar expN = r(N)
 19. 
.           * bootstrap distribution, for Hausman test of weighted vs unweighted
.           reghdfejl `depvar' 1.young#c.nin`new' [pw=`wt'] if e(sample), a(birthyr##c.(`controls') birthpl`new' year) vce(bs, cluster(birthpl`new') procs($procs) reps(1000) seed(`seed') saving("`bs'", replace)
> ) nosamp
 20.           scalar b`wt'exp = _b[1.young#c.nin`new']
 21.           frame bs: use "`bs'.dta", clear
 22.           frame bs: putmata bs`wt'exp = _bs_1, replace
 23. 
.           cap noi reg `depvar' 1.old#c.nin`new' ib1974.birthyr##c.(`controls') i.birthpl`new' i.year [iw=`wt'] if inrange(year,`years') & (`edvar' | year<1974-$reallyoldmax+$retireage) & (old | reallyold)
 24.           if _rc {
 25.             est restore exp
 26.             eststo
 27.             scalar placeboN = .
 28.           }
 29.           else {
 30.             est sto placebo
 31.             qui count if e(sample)
 32.             scalar placeboN = r(N)
 33. 
.             * bootstrap distribution, for Hausman test of weighted vs unweighted
.             reghdfejl `depvar' 1.old#c.nin`new' [pw=`wt'] if e(sample), a(birthyr##c.(`controls') birthpl`new' year) vce(bs, cluster(birthpl`new') procs($procs) reps(1000) seed(`seed') saving("`bs'", replace)
> ) nosamp
 34.             scalar b`wt'plac = _b[1.old#c.nin`new']
 35.             frame bs: use "`bs'.dta", clear
 36.             frame bs: putmata bs`wt'plac = _bs_1, replace
 37. 
.             reg `depvar' 1.young#c.nin`new' ib1974.birthyr##c.(`controls') i.birthpl`new' i.year [iw=`wt'] if inrange(year,`years') & (`edvar' | year<1974-$reallyoldmax+$retireage) & (old | young)
 38.             eststo: suest . placebo, `=cond("`new'"=="","","cluster(birthplnew)")'
 39.             lincom [_LAST_mean]1.young#c.nin`new' - placscale * [placebo_mean]1.old#c.nin`new'
 40.             estadd scalar diff   = r(estimate)
 41.             estadd scalar diffse = r(se)
 42.           }
 43.           estadd scalar expN     = expN    
 44.           estadd scalar placeboN = placeboN
 45.         }
