(4,926,010 observations deleted)
. gen t1 = $age74kink - age74
. gen t2 = max(0,t1)
. local age74minplot 2
. local age74maxplot 24
. local youngmin 2
. local youngmax 6
. local oldmin 12
. local oldmax 17
. local reallyoldmin 18
. local reallyoldmax 24
. local scale = (`oldmax'+`oldmin'-`youngmax'-`youngmin')/(`reallyoldmax'+`reallyoldmin'-`oldmax'-`oldmin')  // factor to scale placebo effect by before comparison to experiment: 10.5/6.5
. 
. forvalues y=1/1 {
  2.   local years: word `y' of 1995,1995 2005,2012 1995,2012
  3.   local yearname: word `y' of 1995 Post-1995 All
  4.   replace       old = inrange(age74,      `oldmin'      ,`oldmax')
  5.   replace reallyold = inrange(age74,`reallyoldmin',`reallyoldmax')
  6. 
.   cap erase "Public/Output/RF`yearname'.rtf"
  7.   forvalues c=1(-1)0 {  // control sets, 0=none, 1=minimal, 2=intermediate, 3=full
  8.     eststo clear
  9.     foreach depvar in primary yeduc part lhwage {
 10.       local edvar = inlist("`depvar'","primary","yeduc")
 11.       foreach new in `=cond(`y'==1 & `c' & inlist("`depvar'","yeduc","lhwage"), `""""', "")' new {
 12.         local controls: word `=`c'+1' of "" ch71`new' "ch71`new' en71`new'" "ch71`new' en71`new' wsppc"
 13. 
.         local seed `c(seed)'
 14.         foreach wt in 1 `=cond("`new'"=="","","wt")' {
 15.           set seed `seed'  // give weighted & unweighted Hausman bootstraps same DGPs
 16. 
.           reg `depvar' 1.young#c.nin`new' ib1974.birthyr##c.(`controls') i.birthpl`new' i.year [pw=`wt'] if inrange(year,`years') & (`edvar' | year<1974-`oldmax'+$retireage) & (old | young)
 17.           est store exp
 18.           qui count if e(sample)
 19.           scalar expN = r(N)
 20. 
.           * bootstrap distribution, for Hausman test of weighted vs unweighted
.           reghdfejl `depvar' 1.young#c.nin`new' [pw=`wt'] if e(sample), a(birthyr##c.(`controls') birthpl`new' year) vce(bs, cluster(birthpl`new') procs($procs) reps(1000) saving("`bs'", replace)) nosamp
 21.           scalar b`wt'exp = _b[1.young#c.nin`new']
 22.           frame bs: use "`bs'.dta", clear
 23.           frame bs: putmata bs`wt'exp = _bs_1, replace
 24. 
.           cap noi reg `depvar' 1.old#c.nin`new' ib1974.birthyr##c.(`controls') i.birthpl`new' i.year [iw=`wt'] if inrange(year,`years') & (`edvar' | year<1974-`reallyoldmax'+$retireage) & (old | reallyold)
 25.           if _rc {
 26.             est restore exp
 27.             eststo
 28.             scalar placeboN = .
 29.           }
 30.           else {
 31.             est sto placebo
 32.             qui count if e(sample)
 33.             scalar placeboN = r(N)
 34. 
.             * bootstrap distribution, for Hausman test of weighted vs unweighted
.             set seed `seed'  // give weighted & unweighted, experiment and placebo, Hausman bootstraps same DGPs
 35.             reghdfejl `depvar' 1.old#c.nin`new' [pw=`wt'] if e(sample), a(birthyr##c.(`controls') birthpl`new' year) vce(bs, cluster(birthpl`new') procs($procs) reps(1000) saving("`bs'", replace)) nosamp
 36.             scalar b`wt'plac = _b[1.old#c.nin`new']
 37.             frame bs: use "`bs'.dta", clear
 38.             frame bs: putmata bs`wt'plac = _bs_1, replace
 39. 
.             reg `depvar' 1.young#c.nin`new' ib1974.birthyr##c.(`controls') i.birthpl`new' i.year [iw=`wt'] if inrange(year,`years') & (`edvar' | year<1974-`reallyoldmax'+$retireage) & (old | young)
 40.             eststo: suest . placebo, `=cond("`new'"=="","","cluster(birthplnew)")'
 41.             lincom [_LAST_mean]1.young#c.nin`new' - `scale' * [placebo_mean]1.old#c.nin`new'
 42.             estadd scalar diff   = r(estimate)
 43.             estadd scalar diffse = r(se)
 44.           }
 45.           estadd scalar expN     = expN    
 46.           estadd scalar placeboN = placeboN
 47.         }
 48.         if "`new'"!="" {
 49.           foreach trial in exp `=cond(placeboN==., "", "plac")' {
 50.             mata st_numscalar("V", variance(bs1`trial' - bswt`trial'))                                      // bootstrap-based Hausman χ²(1) stat. (Cameron and Travedi 2005, p. 378)
 51.             estadd scalar χ²p_`trial' = chi2tail(1, (b1`trial'-bwt`trial')^2 / V): est`=$eststo_counter-1'  // store in previous, unweighted regression
 52.           }
 53.           mata st_numscalar("V", variance(bs1exp - bswtexp - `scale' * (bs1plac - bswtplac)))
 54.           estadd scalar χ²p_diff = chi2tail(1, (b1exp - bwtexp - `scale' * (b1plac - bwtplac))^2 / V): est`=$eststo_counter-1'
 55.         }
 56.       }
 57.     }
